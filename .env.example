# ==============================================================================
# TICKET254 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` to version control.
# ==============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ticket254"

# PostgreSQL Database (Free $0 cloud option: Neon.tech or Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket254?schema=public"

# Cryptographic Secrets (Generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-64-char-hex-session-secret-in-production"
TICKET_QR_SIGNING_SECRET="replace-with-64-char-hex-qr-signing-secret-in-production"
BOOKING_ACCESS_SECRET="replace-with-64-char-hex-booking-token-secret-in-production"

# ==============================================================================
# PAYMENT PROVIDERS (Only genuinely configured providers appear at Checkout)
# ==============================================================================

# 1. Safe Simulated Payment Adapter (Keep "true" ONLY in development/demo; MUST be "false" in production)
ENABLE_SIMULATED_PAYMENTS="true"

# 2. PayPal Orders v2 + Webhooks + Refunds ($0 setup fee — Accepts PayPal Wallet & International Visa/Mastercard)
# Create app at https://developer.paypal.com/dashboard/applications
PAYPAL_ENABLED="false"
PAYPAL_MODE="sandbox" # "sandbox" or "live"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Explicit FX rate used ONLY if converting KES-denominated event orders into USD for PayPal Checkout (e.g., 129.50 KES = 1.00 USD)
PAYPAL_KES_TO_USD_RATE="129.50"

# 3. Paystack Kenya ($0 Starter/Business setup — Accepts M-Pesa STK Push, Visa, Mastercard, Apple Pay in KES & USD)
# Create account at https://dashboard.paystack.com
PAYSTACK_ENABLED="false"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ==============================================================================
# TRANSACTIONAL EMAIL ($0 Free Tiers: Resend 3,000/mo OR Brevo SMTP 300/day)
# ==============================================================================
# Options: "outbox" (DB outbox + dev console), "resend" (Resend HTTP API), "smtp" (Brevo / Gmail / SES SMTP)
EMAIL_PROVIDER="outbox"
EMAIL_FROM="Ticket254 Tickets <tickets@ticket254.example.com>"
SUPPORT_EMAIL="support@ticket254.example.com"

# Option A: Resend Free Tier (https://resend.com — 3,000 emails/mo free, no card required)
RESEND_API_KEY=""

# Option B: Brevo / Gmail Free SMTP
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ==============================================================================
# INVENTORY RESERVATION & SECURITY SETTINGS
# ==============================================================================
RESERVATION_TTL_MINUTES="15"
ORGANISER_FEED_TIMEOUT_MS="5000"
